# Your Freshdesk subdomain: "acme" or "acme.freshdesk.com"
FRESHDESK_DOMAIN=your-subdomain
# Profile settings -> "View API key" in Freshdesk. Never commit the real value.
FRESHDESK_API_KEY=replace-me

# Set to 1 to run against built-in fake data (no Freshdesk account needed)
FRESHDESK_MOCK=0

# Client-side budget. Freshdesk trial accounts allow 50 req/min; paid plans allow more.
FRESHDESK_RATE_LIMIT_PER_MIN=50
# The longest the connector will wait on a 429 before returning an error to the agent
FRESHDESK_MAX_RETRY_WAIT_SECONDS=30

# Data exposure controls
FRESHDESK_INCLUDE_PRIVATE_NOTES=0
FRESHDESK_REDACT_PII=0

# HTTP transport only: a bearer token Agent Studio must send to call this connector
CONNECTOR_AUTH_TOKEN=generate-a-long-random-string
